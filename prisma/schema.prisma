generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DoctoreTier {
  FREE
  PRO
  ENTERPRISE

  @@map("doctore_tier")
}

enum DoctoreBetStatus {
  PENDING
  WON
  LOST
  VOID
  CASHED_OUT

  @@map("doctore_bet_status")
}

enum DoctoreCurrency {
  USD
  EUR
  GBP

  @@map("doctore_currency")
}

model User {
  id                   String         @id @db.Uuid
  email                String         @unique
  clerkUserId          String?        @unique @map("clerk_user_id")
  displayName          String?        @map("display_name")
  tier                 DoctoreTier    @default(FREE)
  defaultKellyFraction Decimal        @default(0.25) @map("default_kelly_fraction") @db.Decimal(5, 4)
  isAdmin              Boolean        @default(false) @map("is_admin")
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  bankroll             Bankroll?
  apiKeys              ApiKey[]
  bets                 Bet[]

  @@index([tier], map: "users_tier_idx")
  @@index([clerkUserId], map: "users_clerk_user_id_idx")
  @@map("users")
}

model Bankroll {
  id        String          @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  userId    String          @unique @map("user_id") @db.Uuid
  amount    Decimal         @default(0) @db.Decimal(14, 2)
  currency  DoctoreCurrency @default(USD)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([currency], map: "bankrolls_currency_idx")
  @@map("bankrolls")
}

model ApiKey {
  id         String    @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  keyHash    String    @unique @map("key_hash")
  label      String?
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "api_keys_user_id_idx")
  @@index([userId, revokedAt], map: "api_keys_user_revoked_idx")
  @@map("api_keys")
}

model Match {
  id              String       @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  externalId      String?      @unique @map("external_id")
  sport           String
  commenceTime    DateTime     @map("commence_time") @db.Timestamptz(6)
  homeTeam        String       @map("home_team")
  awayTeam        String       @map("away_team")
  venueAltitude   Decimal?     @map("venue_altitude") @db.Decimal
  weatherTemp     Decimal?     @map("weather_temp") @db.Decimal
  weatherHumidity Decimal?     @map("weather_humidity") @db.Decimal
  status          String?      @default("upcoming")
  createdAt       DateTime?    @default(now()) @map("created_at") @db.Timestamptz(6)

  predictions     Prediction[]
  bets            Bet[]

  @@map("matches")
}

model Prediction {
  id           String    @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  matchId      String    @unique @map("match_id") @db.Uuid
  homeTeam     String?   @map("home_team")
  awayTeam     String?   @map("away_team")
  modelProb    Float     @map("model_prob")
  marketOdds   Decimal   @map("market_odds") @db.Decimal(10, 4)
  edge         Decimal   @db.Decimal(8, 4)
  commenceAt   DateTime  @map("commence_at") @db.Timestamptz(6)
  modelVersion String?   @map("model_version")
  market       String?
  selection    String?
  source       String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  match        Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  bets         Bet[]

  @@index([commenceAt], map: "predictions_commence_at_idx")
  @@index([edge], map: "predictions_edge_idx")
  @@index([market, selection], map: "predictions_market_selection_idx")
  @@map("predictions")
}

model Bet {
  id            String            @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  predictionId  String?           @map("prediction_id") @db.Uuid
  matchId       String?           @map("match_id") @db.Uuid
  stake         Decimal           @db.Decimal(14, 2)
  odds          Decimal           @db.Decimal(10, 4)
  status        DoctoreBetStatus  @default(PENDING)
  currency      DoctoreCurrency   @default(USD)
  placedAt      DateTime          @default(now()) @map("placed_at") @db.Timestamptz(6)
  settledAt     DateTime?         @map("settled_at") @db.Timestamptz(6)
  notes         String?
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  prediction    Prediction?        @relation(fields: [predictionId], references: [id], onDelete: SetNull)
  match         Match?             @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@index([userId], map: "bets_user_id_idx")
  @@index([status], map: "bets_status_idx")
  @@index([userId, status], map: "bets_user_status_idx")
  @@index([userId, placedAt], map: "bets_user_placed_at_idx")
  @@index([predictionId], map: "bets_prediction_id_idx")
  @@index([matchId], map: "bets_match_id_idx")
  @@map("bets")
}
